#!/usr/bin/env ruby
# frozen_string_literal: true

root = File.expand_path("..", __dir__)
environment = { "BUNDLE_GEMFILE" => File.join(root, "Gemfile"), "RAILS_ENV" => "test" }
exit 1 unless system(environment, "bundle", "exec", "rake", "db:prepare")

native = ARGV.delete("--native")
pattern = native ? "spec/**/*browser_spec.rb" : "spec/**/*_spec.rb"
files = Dir[File.join(root, pattern)]
files.reject! { |path| path.include?("browser_spec.rb") } unless native
exec(environment, "bundle", "exec", "rspec", *files.sort, *ARGV)
